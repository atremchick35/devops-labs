rules:
  # доля полезных байтов от всех байтов образа
  lowestEfficiency: 0.95
  # сколько байт можно потерять на удалённых и перезаписанных файлах;
  # ~5.7 MB неустранимо приходят из слоёв python:3.14-slim (debconf, dpkg), остальное - запас
  highestWastedBytes: 10MB
  # доля потерянного от добавленного нашими слоями
  highestUserWastedPercent: 0.10
